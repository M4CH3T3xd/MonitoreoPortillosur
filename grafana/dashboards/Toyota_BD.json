        "defaults": {
          "color": { "mode": "thresholds" },
          "links": [
            {
              "targetBlank": true,
              "title": "🔍 Ver evidencia del error en Logs",
              "url": "/explore?left=[\"${__from}\",\"${__to}\",\"Loki\",{\"expr\":\"{job=\\\"toyota_integracion\\\"} |= \\\"error_integracion_sap\\\"\"}]"
            }
          ],
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
